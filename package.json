{
  "name": "rankmaker",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:worker": "pnpm exec wrangler deploy -c dist/server/wrangler.json",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "node .github/scripts/smoke-build.mjs",
    "astro": "astro",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "gen:brand-cover": "node .github/scripts/generate-brand-cover.mjs",
    "check:deploy": "npx --yes tsx .github/scripts/check-deploy-readiness.ts",
    "wrangler": "wrangler",
    "db:create": "wrangler d1 create rankmaker",
    "db:migrate:new": "wrangler d1 migrations create rankmaker",
    "db:migrate:list": "wrangler d1 migrations list rankmaker --local",
    "db:migrate:local": "wrangler d1 migrations apply rankmaker --local",
    "db:migrate:remote": "wrangler d1 migrations apply rankmaker --remote",
    "db:counts:remote": "wrangler d1 execute rankmaker --remote --command \"SELECT slug, COUNT(*) AS n FROM rankings GROUP BY slug ORDER BY n DESC LIMIT 15\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/preact": "^6.0.4",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "preact": "^10.29.8",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^25.9.3",
    "@types/sortablejs": "^1.15.9",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.11.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
