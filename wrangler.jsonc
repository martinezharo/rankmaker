{
  "main": "dist/_worker.js/index.js",
  "name": "rankmaker",
  "account_id": "a0fa518f5393767beb33f26606989c9d",
  "compatibility_date": "2026-02-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Edge caching for the Worker's OWN responses. Without this, Cloudflare runs
  // the Worker on every request and the `Cache-Control` headers our pages set
  // only ever reach the browser — the shared-cache directives (`s-maxage`,
  // `stale-while-revalidate`) are inert. With it, Cloudflare checks the cache
  // BEFORE invoking the Worker and honours those directives per RFC 9111.
  //
  // Consequence worth remembering: the cache key is path + query and does NOT
  // include cookies, so any page whose body depends on a cookie must either be
  // `no-store` or render a canonical (cookie-independent) response. See
  // src/lib/mature.ts — that is the only cookie we render from.
  "cache": {
    "enabled": true
  },

  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Server-side re-encode of user uploads to WebP (Images binding).
  "images": {
    "binding": "IMAGES"
  },
  // Existing bucket behind img.rankmaker.net. Official assets live under
  // covers/ and options/; user uploads go under u/{userId}/.
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "rankmaker-imgs"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "rm-times-ranked",
      "id": "0c639d01caa544908bde56c1de3e143c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rankmaker",
      "database_id": "fae5241a-0498-47d3-bbc0-fff72a1cb6f6",
      "migrations_dir": "migrations"
    }
  ]
}