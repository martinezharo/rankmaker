---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PreferenceRow from "../components/PreferenceRow.astro";
import LanguageSelect from "../components/LanguageSelect.astro";
import { getSessionUser } from "../lib/auth";
import { getMarketingConsent } from "../lib/marketing-consent";
import { getEmailPref } from "../lib/notifications";
import { readMaturePref, writeMaturePref } from "../lib/mature";
import { defaultLocale, localizePath, useTranslations } from "../i18n/server";
import { getDb } from "../lib/runtime";

const locale = Astro.locals.locale ?? defaultLocale;
const t = useTranslations(locale);

// Everything here is per-visitor state, so the page is never cached.
Astro.response.headers.set("Cache-Control", "private, no-store");

let user: Awaited<ReturnType<typeof getSessionUser>> = null;
let emailPref = true;
let marketingPref = false;
try {
    const db = getDb();
    user = await getSessionUser(Astro.cookies, db);
    if (user) {
        [emailPref, marketingPref] = await Promise.all([
            getEmailPref(db, user.id),
            getMarketingConsent(db, user.id),
        ]);
    }
} catch (error) {
    // Preferences that need a session degrade to the signed-out view rather
    // than 500-ing the page — the language and mature switches still work.
    console.error("preferences: session lookup failed:", error);
}

// Everywhere else the render path reads the cookie, but this page is where the
// value is edited, so it shows the authoritative one: the account for signed-in
// users (which may have been changed on another device), the cookie otherwise.
// Re-stamping the cookie here means the rest of the site agrees immediately,
// without waiting for the next /api/auth/me.
const showMature = user ? user.showMature : readMaturePref(Astro.cookies);
if (user && readMaturePref(Astro.cookies) !== showMature) {
    writeMaturePref(Astro.cookies, showMature);
}

// Same pattern as /saved: send the visitor back here after signing in.
const loginHref = `/api/auth/login?next=${encodeURIComponent(
    localizePath("/preferences", locale),
)}`;

const cardClass = "rounded-2xl bg-surface-elevated border border-border p-5 sm:p-6";
const headingClass =
    "text-sm font-bold text-text-primary uppercase tracking-wider flex items-center gap-2";
// Rows after the first are separated by a hairline rather than by a whole card.
const stackedRowClass = "pt-5 mt-5 border-t border-border first:pt-0 first:mt-0 first:border-t-0";
---

<Layout
    title={t("preferences.title")}
    description={t("preferences.metaDescription")}
    noindex
>
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12 space-y-6">
        <header class="space-y-2">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-text-primary">
                <i class="fa-solid fa-sliders text-primary text-xl mr-2"></i>
                {t("preferences.heading")}
            </h1>
            <p class="text-sm text-text-muted">{t("preferences.subtitle")}</p>
        </header>

        <!-- Language ------------------------------------------------------->
        <section class={cardClass}>
            <div class="mb-4">
                <h2 class={headingClass}>
                    <i class="fa-solid fa-globe text-primary text-xs"></i>
                    {t("preferences.languageHeading")}
                </h2>
                <p class="text-xs text-text-muted mt-1">
                    {t("preferences.languageDesc")}
                </p>
            </div>

            <LanguageSelect class="w-full sm:max-w-xs" />
        </section>

        <!-- Content -------------------------------------------------------->
        <section class={cardClass}>
            <h2 class:list={[headingClass, "mb-4"]}>
                <i class="fa-solid fa-eye text-primary text-xs"></i>
                {t("preferences.contentHeading")}
            </h2>

            <PreferenceRow
                id="mature-pref-toggle"
                label={t("preferences.matureLabel")}
                description={t("preferences.matureDesc")}
                toggleLabel={t("preferences.matureToggle")}
                checked={showMature}
                prefKey="showMature"
                note={user
                    ? t("preferences.savedOnAccount")
                    : t("preferences.savedInBrowser")}
            />
        </section>

        <!-- Email ---------------------------------------------------------->
        <section class={cardClass}>
            <h2 class:list={[headingClass, "mb-4"]}>
                <i class="fa-solid fa-envelope text-primary text-xs"></i>
                {t("preferences.emailHeading")}
            </h2>

            {
                user ? (
                    <div>
                        <PreferenceRow
                            class={stackedRowClass}
                            id="email-pref-toggle"
                            label={t("preferences.emailPrefHeading")}
                            description={t("preferences.emailPrefDesc")}
                            toggleLabel={t("preferences.emailPrefToggle")}
                            checked={emailPref}
                            prefKey="emailNotifications"
                        />
                        <PreferenceRow
                            class={stackedRowClass}
                            id="marketing-pref-toggle"
                            label={t("preferences.marketingHeading")}
                            description={t("preferences.marketingDesc")}
                            toggleLabel={t("preferences.marketingToggle")}
                            checked={marketingPref}
                            prefKey="marketingEmails"
                        >
                            <a
                                href={localizePath("/privacy-policy", locale)}
                                class="text-primary hover:underline font-medium"
                            >
                                {t("preferences.marketingPolicy")}
                            </a>
                        </PreferenceRow>
                    </div>
                ) : (
                    <p class="text-sm text-text-muted">
                        {t("preferences.emailPrefLoginHint")}
                    </p>
                )
            }
        </section>

        {
            !user && (
                <p class="text-xs text-text-muted text-center">
                    <a
                        href={loginHref}
                        data-astro-reload
                        class="auth-login-link text-primary hover:underline font-medium"
                    >
                        {t("preferences.signInHint")}
                    </a>
                </p>
            )
        }
    </div>
</Layout>

<script>
    import { bindPreferenceToggles } from "../scripts/preference-toggle";

    document.addEventListener("astro:page-load", bindPreferenceToggles);
</script>
