---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import TemplateForm from "../components/TemplateForm.astro";
import { getSessionUser } from "../lib/auth";
import { defaultLocale, useTranslations } from "../i18n";

const locale = Astro.locals.locale ?? defaultLocale;
const t = useTranslations(locale);

// Guests can build a template too — restricted to private, no images (see
// TemplateForm's `anonymous` mode) — instead of being bounced to login. The
// login modal (triggered from the form) is what eventually gets them signed
// in, at which point a real submit is required (see /api/templates POST).
const user = await getSessionUser(Astro.cookies, Astro.locals.runtime.env.DB);

Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout title={t("create.title")} description={t("create.metaDescription")}>
    <section class="mx-auto max-w-3xl px-4 sm:px-6 py-10 pb-20">
        <div class="mb-8">
            <h1
                class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary"
            >
                {t("create.heading")}
            </h1>
            <p class="text-sm text-text-secondary mt-2">
                {t("create.intro")}
            </p>
        </div>

        <TemplateForm mode="create" anonymous={!user} />
    </section>
</Layout>
