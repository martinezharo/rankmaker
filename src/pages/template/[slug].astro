---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import TemplateCover from "../../components/TemplateCover.astro";
import Avatar from "../../components/Avatar.astro";
import BattleView from "../../components/ranking/BattleView.astro";
import OptionCard from "../../components/ranking/OptionCard.astro";
import ResultsView from "../../components/ranking/ResultsView.astro";
import FinishEarlyModal from "../../components/ranking/FinishEarlyModal.astro";
import RemoveOptionModal from "../../components/ranking/RemoveOptionModal.astro";
import BattleHistoryModal from "../../components/ranking/BattleHistoryModal.astro";
import RankingComments from "../../components/ranking/RankingComments.astro";
import RecommendedTemplates from "../../components/RecommendedTemplates.astro";
import { getTemplateBySlug, getRecommendedTemplates } from "../../lib/templates";
import { categoryIcon } from "../../lib/categories";
import { resolveImageUrl } from "../../lib/covers";
import { buildRankingData } from "../../lib/ranking-data";
import { serializeJsonForScript } from "../../lib/safe-json";
import { getSessionUser } from "../../lib/auth";
import { isMatureGated, readMaturePref } from "../../lib/mature";
import { defaultLocale, localizePath, useTranslations } from "../../i18n";

const locale = Astro.locals.locale ?? defaultLocale;
const t = useTranslations(locale);
const L = (p: string) => localizePath(p, locale);

// Served on demand: official templates resolve from the bundled JSON (no D1
// read), user templates from D1. A null body + 404 makes Astro render 404.astro.
const db = Astro.locals.runtime.env.DB;
// Official templates resolve from bundled JSON (no D1). A user template needs a
// D1 read; on a transient failure signal "try again" (503) rather than a 404 —
// a 404 on the page we most want indexed risks it being dropped from the index.
let template: Awaited<ReturnType<typeof getTemplateBySlug>>;
try {
    template = await getTemplateBySlug(db, Astro.params.slug as string);
} catch (err) {
    console.error("template load failed:", err);
    return new Response(null, {
        status: 503,
        headers: { "Retry-After": "30" },
    });
}
if (!template) {
    return new Response(null, { status: 404 });
}

// Private templates: only the creator may view. Same 404 as "doesn't exist"
// so the slug doesn't leak. Unlisted: anyone with the (random) URL.
const isHidden = template.source === "user" && template.visibility !== "public";
if (template.visibility === "private") {
    // Fail closed on a session-lookup blip (treat as non-creator → 404).
    // Private pages are noindex, so this never affects search.
    let viewer = null;
    try {
        viewer = await getSessionUser(Astro.cookies, db);
    } catch (err) {
        console.error("session lookup failed:", err);
    }
    if (!viewer || viewer.username !== template.creator.username) {
        return new Response(null, {
            status: 404,
            headers: {
                "Cache-Control": "private, no-store",
                "X-Robots-Tag": "noindex, nofollow",
            },
        });
    }
}

// Mature content: flagged templates are kept out of every listing, and a
// PUBLIC one opened directly is blurred behind a confirmation dialog until the
// visitor opts in. Private/unlisted templates carry the flag but nothing acts
// on it — they are already unlisted (see src/lib/mature.ts).
const showMature = readMaturePref(Astro.cookies);
const matureGated = isMatureGated(template, showMature);

const { options, creator } = template;

// Official pages change rarely; user templates may be edited (≤60s staleness).
// Hidden templates are never cached: private responses depend on the session,
// and unlisted URLs shouldn't sit in shared caches.
//
// For officials we extend the edge freshness window to 1h with a 24h
// stale-while-revalidate grace: the page does 3 D1 reads per render (template
// + voteScore + recommendations) that are purely decorative — counts are
// refreshed client-side via /api/counts on every page-load, so a 1h HTML cache
// can't surface stale ranking numbers to users. This keeps cold-cache visitors
// off the Worker most of the time, dropping TTFB from ~1s to <50ms.
//
// A template flagged as mature renders two different pages (gated / not gated)
// for the same URL depending on a cookie, so it is never cached at all —
// a shared cache could otherwise hand the ungated page to someone who never
// opted in.
Astro.response.headers.set(
    "Cache-Control",
    isHidden || template.is_mature
        ? "no-store"
        : template.source === "official"
          ? "public, max-age=60, s-maxage=3600, stale-while-revalidate=86400"
          : "public, max-age=60",
);

// Belt and braces with the <meta> robots tag in Layout.
if (isHidden) {
    Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
    // /api/counts excludes hidden slugs (it would leak them), so fetch the
    // real count here server-side instead of via the client counts script.
    try {
        const row = await db
            .prepare("SELECT COUNT(*) AS n FROM rankings WHERE slug = ? COLLATE NOCASE")
            .bind(template.slug)
            .first<{ n: number }>();
        template.times_ranked = row?.n ?? 0;
    } catch (err) {
        // Count is decorative — keep the existing value on a D1 blip.
        console.error("times-ranked count failed:", err);
    }
}

// Net up/down vote score for the read-only display. The interactive vote
// controls (battle/results views) refresh this client-side via the
// /api/templates/vote endpoint, since this page may be cached. Decorative, so
// a transient D1 failure degrades to 0 rather than 500-ing the whole page.
let voteScore = 0;
try {
    const voteRow = await db
        .prepare(
            "SELECT COALESCE(SUM(value), 0) AS score FROM votes WHERE subject_type = 'template' AND subject_id = ? COLLATE NOCASE",
        )
        .bind(template.slug)
        .first<{ score: number }>();
    voteScore = voteRow?.score ?? 0;
} catch (err) {
    console.error("vote score failed:", err);
}

const icon = categoryIcon(template.category);
const coverSrc = resolveImageUrl(template.cover_image);

// Ranking engine input. Embedded as a JSON script element inside the swapped
// DOM (not a global set by a separate inline script) so the options can never
// desync from the title/URL during a ViewTransitions navigation — a stale
// global previously caused "right template, wrong options" on interrupted nav.
const rankingData = buildRankingData({
    slug: template.slug,
    title: template.title,
    cover: coverSrc,
    options: options ?? [],
});

// Structured data: each template page is a ranked list of options.
// Skipped for hidden templates — they're noindex anyway.
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: template.title,
    ...(template.description && { description: template.description }),
    url: new URL(Astro.url.pathname, "https://rankmaker.net").toString(),
    numberOfItems: options?.length ?? 0,
    itemListElement: (options ?? []).map((o, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: o.name,
    })),
};

// Related templates for the "You might also like" row, shown under every view.
// Scored in-memory; degrades to officials-only if D1 is unavailable.
let recommendations: Awaited<ReturnType<typeof getRecommendedTemplates>> = [];
try {
    // Over-fetch: the client hides already-played templates and trims to 8,
    // so a few extra candidates keep the row full for returning users.
    recommendations = await getRecommendedTemplates(
        db,
        template,
        12,
        showMature,
    );
} catch {
    // non-fatal — the page renders without the row
}
---

<Layout
    title={t("ranking.pageTitle", { title: template.title })}
    description={template.description || undefined}
    image={coverSrc}
    preloadImage={coverSrc}
    noindex={isHidden || template.is_mature}
    matureGated={matureGated}
>
    {
        !isHidden && !template.is_mature && (
            <script
                type="application/ld+json"
                set:html={serializeJsonForScript(jsonLd)}
                is:inline
            />
        )
    }
    <!-- Pre-paint guard: if this browser already has a saved result for this
         template, the page lands on the results view — but that decision is
         made by the bundled module on astro:page-load, i.e. after first paint,
         so the cached detail-view HTML flashed for a moment. This inline
         script re-runs on every swap, peeks at the same storage keys as
         maybeShowSavedResult (WITHOUT consuming the one-shot sessionStorage
         flags — the module still owns that) and hides detail view + START CTA
         via a class on <html> (rule in global.css) before anything paints.
         rankingInit removes the class once the real hidden classes are set. -->
    <script is:inline data-astro-rerun define:vars={{ slug: template.slug }}>
        (() => {
            const root = document.documentElement;
            root.classList.remove("rm-saved-result");
            try {
                const ss = (k) => JSON.parse(sessionStorage.getItem(k) || "null");
                if (ss("rankmaker_force_fresh") === slug) return;
                const shows = (r) => Array.isArray(r) && r.length >= 2;
                const pending = ss("rankmaker_pending_result");
                if (pending && pending.slug === slug && pending.result) {
                    if (shows(pending.result)) root.classList.add("rm-saved-result");
                    return;
                }
                const map = JSON.parse(localStorage.getItem("rankmaker_history") || "null");
                const local = map && map[slug];
                if (local && shows(local.result)) root.classList.add("rm-saved-result");
            } catch {
                /* storage unavailable — the module decides after paint as before */
            }
        })();
    </script>
    <!-- ═══════════════════════════════════════════════════
         VIEW 1: TEMPLATE DETAIL (default)
         ═══════════════════════════════════════════════════ -->
    <article
        id="detail-view"
        class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 pb-28"
    >
        <!-- Back Navigation -->
        <a
            href={L("/")}
            class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-text-primary transition-colors mb-8 group"
        >
            <i
                class="fa-solid fa-arrow-left text-xs transition-transform group-hover:-translate-x-1"
            ></i>
            {t("ranking.backToTemplates")}
        </a>

        <!-- Template Header -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
            <!-- Cover Image -->
            <div
                class="relative rounded-2xl overflow-hidden bg-surface-elevated border border-border aspect-4/3"
            >
                <TemplateCover
                    cover={template.cover_image}
                    collage={template.collage}
                    title={template.title}
                    className="w-full h-full object-cover"
                    priority
                />
            </div>

            <div class="flex flex-col justify-center space-y-5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2 flex-wrap">
                        {
                            template.category && (
                                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary/10 text-primary text-xs font-semibold uppercase tracking-wider">
                                    <i class={`fa-solid ${icon} text-[10px]`} />
                                    {t(`categories.${template.category}`)}
                                </span>
                            )
                        }
                        {
                            isHidden && (
                                <span
                                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-elevated border border-border text-text-muted text-xs font-semibold uppercase tracking-wider"
                                    data-rm-tip={
                                        template.visibility === "private"
                                            ? t("tooltip.visibilityPrivate")
                                            : t("tooltip.visibilityUnlisted")
                                    }
                                    data-rm-tip-placement="bottom"
                                >
                                    <i
                                        class={`fa-solid ${template.visibility === "private" ? "fa-lock" : "fa-link"} text-[10px]`}
                                    />
                                    {template.visibility === "private"
                                        ? t("me.visibilityPrivate")
                                        : t("me.visibilityUnlisted")}
                                </span>
                            )
                        }
                    </div>
                    <button
                        id="share-template-btn"
                        class="w-10 h-10 rounded-xl bg-surface-elevated border border-border flex items-center justify-center text-text-secondary hover:text-primary hover:border-primary/50 transition-all duration-200"
                        aria-label={t("card.shareAria")}
                        data-rm-tip={t("tooltip.shareTemplate")}
                        data-title={template.title}
                    >
                        <i class="fa-solid fa-share-nodes text-sm"></i>
                    </button>
                </div>

                <h1
                    class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary leading-tight"
                >
                    {template.title}
                </h1>

                <!-- Creator -->
                <a
                    href={L(`/u/${encodeURIComponent(creator.username)}`)}
                    class="group/creator inline-flex items-center gap-2.5 w-fit"
                >
                    <Avatar
                        avatar={creator.avatar}
                        size="md"
                        verified={creator.isVerified}
                    />
                    <span>
                        <span
                            class="block text-[10px] uppercase tracking-wider text-text-muted font-semibold"
                            >{t("ranking.createdBy")}</span
                        >
                        <span
                            class="text-sm font-semibold text-text-secondary group-hover/creator:text-text-primary transition-colors"
                        >
                            @{creator.username}
                        </span>
                    </span>
                </a>

                {
                    template.description && (
                        <p class="text-text-secondary leading-relaxed">
                            {template.description}
                        </p>
                    )
                }

                <div class="flex items-center gap-6 text-sm">
                    <div class="flex items-center gap-2 text-text-muted">
                        <i class="fa-solid fa-fire text-primary/70 text-xs"></i>
                        <span
                            class="font-medium"
                            data-count-slug={isHidden ? undefined : template.slug}
                            >{t("card.ranked", { n: template.times_ranked.toLocaleString() })}</span
                        >
                    </div>
                    <div class="flex items-center gap-2 text-text-muted">
                        <i class="fa-solid fa-arrow-up text-primary/70 text-xs"></i>
                        <span class="font-medium" data-vote-score
                            >{t("card.votes", { n: voteScore.toLocaleString() })}</span
                        >
                    </div>
                    {
                        options && (
                            <div class="flex items-center gap-2 text-text-muted">
                                <i class="fa-solid fa-layer-group text-primary/70 text-xs" />
                                <span class="font-medium">
                                    {t("ranking.optionsCount", { n: options.length })}
                                </span>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>

        <!-- Share script -->
        <script>
            import { clientT } from "../../i18n/client";
            import { initSaveButtons } from "../../scripts/save-template";
            import { initTemplateVote } from "../../scripts/template-vote";

            document.addEventListener("astro:page-load", () => {
                initSaveButtons();
                initTemplateVote();

                const shareBtn = document.getElementById("share-template-btn");
                if (!shareBtn) return;
                const t = clientT();
                shareBtn.addEventListener("click", async () => {
                    const title = shareBtn.dataset.title;
                    const url = window.location.href;
                    if (navigator.share) {
                        try {
                            await navigator.share({
                                title: t("card.shareTitle", { title: title || "" }),
                                url,
                            });
                        } catch (err) {
                            console.error("Error sharing:", err);
                        }
                    } else {
                        try {
                            await navigator.clipboard.writeText(url);
                            const ic = shareBtn.querySelector("i");
                            if (ic) {
                                ic.className =
                                    "fa-solid fa-check text-sm text-emerald-500";
                                setTimeout(() => {
                                    ic.className =
                                        "fa-solid fa-share-nodes text-sm";
                                }, 2000);
                            }
                        } catch (err) {
                            console.error("Error copying:", err);
                        }
                    }
                });
            });
        </script>

        <!-- Options Grid -->
        {
            options && options.length > 0 && (
                <section class="mt-14">
                    <div class="flex items-center gap-3 mb-6">
                        <h2 class="text-lg font-bold text-text-primary tracking-tight">
                            {t("ranking.availableOptions")}
                        </h2>
                        <div class="flex-1 h-px bg-border/50" />
                        <span class="text-xs text-text-muted font-medium">
                            {t("ranking.itemsCount", { n: options.length })}
                        </span>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                        {options.map((option) => (
                            <OptionCard
                                id={option.id}
                                name={option.name}
                                image={option.image}
                            />
                        ))}
                    </div>
                </section>
            )
        }

    </article>

    <!-- Floating CTA Button -->
    <div
        id="start-ranking-cta"
        class="fixed bottom-20 md:bottom-6 right-6 z-40 flex items-center gap-3"
    >
        <button
            id="save-template-btn"
            class="save-btn group flex items-center gap-2 px-5 py-4 rounded-2xl bg-surface-elevated border border-border hover:border-primary/60 text-text-secondary hover:text-text-primary font-semibold text-sm transition-all duration-200 cursor-pointer"
            aria-label={t("card.saveAria")}
            data-save-aria={t("card.saveAria")}
            data-unsave-aria={t("card.unsaveAria")}
            data-save-tip={t("tooltip.save")}
            data-unsave-tip={t("tooltip.unsave")}
            data-rm-tip={t("tooltip.save")}
            data-slug={template.slug}
        >
            <i class="fa-regular fa-bookmark text-sm"></i>
            <span
                class="save-label"
                data-label-save={t("ranking.saveTemplate")}
                data-label-saved={t("ranking.savedTemplate")}
                >{t("ranking.saveTemplate")}</span
            >
        </button>
        <button
            id="start-ranking-btn"
            class="group flex items-center gap-3 px-7 py-4 rounded-2xl bg-gradient-gold text-zinc-950 font-black text-sm glow-gold hover:shadow-[0_8px_60px_rgba(255,215,0,0.5)] hover:scale-[1.03] active:scale-[0.97] transition-all duration-200 cursor-pointer"
        >
            <i class="fa-solid fa-play text-xs"></i>
            {t("ranking.startRanking")}
            <i
                class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"
            ></i>
        </button>
    </div>

    <!-- VIEW 2: BATTLE VIEW -->
    <BattleView title={template.title} />

    <FinishEarlyModal />

    <RemoveOptionModal />

    <!-- VIEW 3: RESULTS VIEW -->
    <ResultsView title={template.title} creator={creator} />

    <BattleHistoryModal />

    <!-- Comments — visible at the foot of all three views, above recommendations -->
    <RankingComments slug={template.slug} />

    <!-- Related templates — visible at the foot of all three views -->
    <RecommendedTemplates templates={recommendations} />

    <!-- ═══════════════════════════════════════════════════
         EPIC TRANSITION OVERLAY
         ═══════════════════════════════════════════════════ -->
    <div id="transition-overlay" class="hidden transition-overlay"></div>

    <!-- ═══════════════════════════════════════════════════
         OPTIONS DATA (read from the DOM by the engine)
         A pure-data script: never executed, swapped in with the rest of the
         page, so the engine always reads the options for the page actually
         on screen — no global that can lag behind the swapped title/URL.
         ═══════════════════════════════════════════════════ -->
    <script
        type="application/json"
        id="ranking-data"
        is:inline
        set:html={serializeJsonForScript(rankingData)}
    />

    <!-- ═══════════════════════════════════════════════════
         RANKING ENGINE + UI CONTROLLER
         The controller lives in src/scripts/ranking-engine.ts: it is shared
         with the guest-local template page and reads everything it needs from
         the #ranking-data element above.
         ═══════════════════════════════════════════════════ -->
    <script>
        import { rankingInit } from "../../scripts/ranking-engine";

        document.addEventListener("astro:page-load", rankingInit);
    </script>
</Layout>
